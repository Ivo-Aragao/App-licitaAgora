{
  "name": "licita360",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node server/index.js",
    "build": "prisma generate && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start:server": "node server/index.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^7.10.0",
    "vite": "^6.0.7"
  }
}
